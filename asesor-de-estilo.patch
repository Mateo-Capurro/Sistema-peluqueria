+        @if (paso() === 'inicio') {
+          <div class="text-center px-8">
+            <p class="text-alma-cream/70 text-sm font-light">
+              De frente, con buena luz, sin anteojos y con el pelo despejado de la frente.
+            </p>
+          </div>
+        }
+        @if (paso() === 'analizando') {
+          <div class="absolute inset-0 bg-alma-ink/60 flex items-center justify-center">
+            <p class="text-alma-cream text-sm uppercase tracking-widest animate-pulse">Analizando&hellip;</p>
+          </div>
+        }
+      </div>
+
+      <div class="flex flex-wrap gap-3">
+        @switch (paso()) {
+          @case ('inicio') {
+            <button class="alma-btn" (click)="abrirCamara()">Abrir c&aacute;mara</button>
+            <label class="alma-btn-outline">
+              Subir foto
+              <input type="file" accept="image/*" class="hidden" (change)="subirFoto($event)" />
+            </label>
+          }
+          @case ('camara') {
+            <button class="alma-btn" (click)="capturar()">Sacar foto</button>
