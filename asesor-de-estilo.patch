+        </div>
+
+        <div class="grid grid-cols-3 gap-3 text-center border-y border-alma-line py-4">
+          <div>
+            <p class="text-lg font-semibold text-alma-ink">{{ r.medidas.ratioLargoAncho.toFixed(2) }}</p>
+            <p class="text-[11px] uppercase tracking-widest text-alma-muted">Largo / ancho</p>
+          </div>
+          <div>
+            <p class="text-lg font-semibold text-alma-ink">{{ porcentaje(r.medidas.ratioFrente) }}</p>
+            <p class="text-[11px] uppercase tracking-widest text-alma-muted">Frente</p>
+          </div>
+          <div>
+            <p class="text-lg font-semibold text-alma-ink">{{ porcentaje(r.medidas.ratioMandibula) }}</p>
+            <p class="text-[11px] uppercase tracking-widest text-alma-muted">Mand&iacute;bula</p>
+          </div>
+        </div>
+
+        <div>
+          <p class="alma-label">Cortes recomendados</p>
+          <ul class="space-y-3">
+            @for (rec of recomendaciones(); track rec.nombre) {
+              <li class="border-l-2 border-alma-accent pl-4">
+                <p class="font-serif text-lg text-alma-ink">{{ rec.nombre }}</p>
+                <p class="text-sm text-alma-body">{{ rec.descripcion }}</p>
+              </li>
+            }
+          </ul>
+        </div>
+
+        <div class="mt-auto pt-2 flex flex-col gap-2">
+          <button class="alma-btn self-start" (click)="reservar()">Reservar corte &rarr;</button>
+          <p class="text-[12px] text-alma-muted">
+            Es una sugerencia orientativa. Tu estilista la ajusta seg&uacute;n tu tipo de pelo y lo que busc&aacute;s.
+          </p>
+        </div>
+      } @else {
+        <p class="alma-eyebrow">C&oacute;mo funciona</p>
+        <ol class="space-y-4 text-sm text-alma-body">
+          <li><span class="font-semibold text-alma-ink">1.</span> Detectamos 478 puntos de tu rostro con visi&oacute;n por computadora.</li>
+          <li><span class="font-semibold text-alma-ink">2.</span> Medimos largo, ancho de frente, pómulos y mandíbula.</li>
+          <li><span class="font-semibold text-alma-ink">3.</span> Con esas proporciones identificamos tu forma de rostro.</li>
+          <li><span class="font-semibold text-alma-ink">4.</span> Te sugerimos cortes que la favorecen y pod&eacute;s reservar al instante.</li>
+        </ol>
+      }
+    </div>
+  </div>
+</div>
